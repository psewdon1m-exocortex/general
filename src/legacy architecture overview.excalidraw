    },
    {
      "id": "e_aXal7FPtcvSVC4z_WHU",
      "type": "text",
      "x": 4724.951481955073,
      "y": 2745.2985234041225,
      "width": 400.51666259765625,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
