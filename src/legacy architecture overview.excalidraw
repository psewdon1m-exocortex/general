    {
      "id": "ZcAxYz_5kjV8BdXbd4XbC",
      "type": "text",
      "x": 1845.6456411357894,
      "y": 4358.099138262231,
      "width": 656.7833251953125,
      "height": 150,
      "angle": 5.292173484232801,
